POSTGRES_PORT=55432
KEYCLOAK_PORT=8180
MINISTACK_PORT=4566
WALLET_1_PORT=8081
WALLET_2_PORT=8082
WALLET_3_PORT=8083

HTTP_ADDR=:8080
LOG_LEVEL=info
REQUEST_TIMEOUT=10s
SHUTDOWN_TIMEOUT=25s

DATABASE_URL=postgres://wallet_app:wallet_app@localhost:55432/wallet?sslmode=disable
MIGRATION_DATABASE_URL=postgres://wallet:wallet@localhost:55432/wallet?sslmode=disable
DB_MAX_CONNS=20
DB_LOCK_TIMEOUT=5s
DB_STATEMENT_TIMEOUT=15s

OIDC_ISSUER=http://keycloak:8080/realms/wallet
OIDC_JWKS_URL=http://localhost:8180/realms/wallet/protocol/openid-connect/certs
OIDC_AUDIENCE=wallet-api

AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=wallet-service
AWS_SECRET_ACCESS_KEY=wallet-service-secret
SQS_WAGER_QUEUE=wager-transactions.fifo
SQS_WAGER_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wallet-events.fifo
SQS_CONSUMER_NAME=wallet-wager-consumer
SQS_CONSUMER_WORKERS=4
SQS_WAIT_SECONDS=10
SQS_VISIBILITY_TIMEOUT=30
SQS_HANDLE_TIMEOUT=20s
SQS_MAX_RECEIVES=5
SQS_ALLOWED_SENDERS=000000000000=*

CONSUMER_ENABLED=true
OUTBOX_ENABLED=true
REFERENCES_ENABLED=true
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BATCH=100
OUTBOX_LEASE=30s
OUTBOX_MAX_BACKOFF=1m
REFERENCE_POLL_INTERVAL=500ms
REFERENCE_BATCH=20
REFERENCE_LEASE=30s
REFERENCE_TTL=5m
REFERENCE_MAX_ATTEMPTS=20
REFERENCE_INITIAL_BACKOFF=1s
REFERENCE_MAX_BACKOFF=30s

FAULT_POINTS=
